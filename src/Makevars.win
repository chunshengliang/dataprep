# Windows-specific Makevars. Hand-written; NOT generated by configure.
# configure does not run on Windows, so this file is the only source of
# OpenMP flags there. -O3 is deliberately omitted: CRAN flags it as
# non-portable and it is not needed on Windows.
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)
PKG_LIBS     = $(SHLIB_OPENMP_CXXFLAGS)
